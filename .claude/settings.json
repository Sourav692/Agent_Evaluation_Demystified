{
  "permissions": {
    "allow": [
      "Bash(uv pip *)",
      "Bash(python3 -c ' *)",
      "Skill(stitch-design)",
      "Skill(stitch-design:*)",
      "Bash(python3)",
      "Bash(python3 -c \"import deepagents; print\\(deepagents.__file__\\)\")",
      "Bash(npm create *)",
      "Bash(npm install *)",
      "Bash(python -c ' *)"
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "env": {
    "MLFLOW_DISABLE_AGENT_HINT": "1",
    "MLFLOW_LOGGING_LEVEL": "WARNING",
    "PYTHONWARNINGS": "ignore::UserWarning"
  }
}
