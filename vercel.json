{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m venv /tmp/sitebuild && /tmp/sitebuild/bin/pip install --quiet -r site/requirements.txt && /tmp/sitebuild/bin/python site/build.py",
  "outputDirectory": "site/dist",
  "installCommand": "echo 'no package manager: the site is built by site/build.py'",
  "framework": null,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/online-vs-offline.html",
      "destination": "/databricks-mlflow.html#part-5-online-vs-offline",
      "permanent": true
    },
    {
      "source": "/stratified-reporting-explained.html",
      "destination": "/05-statistics-and-stratified-reporting.html",
      "permanent": true
    },
    {
      "source": "/fde-playbook-audit.html",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/fde-playbook-end-to-end-evaluation.html",
      "destination": "/index.html",
      "permanent": false
    }
  ]
}
