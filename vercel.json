{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m venv /tmp/sitebuild && /tmp/sitebuild/bin/pip install --quiet -r site/requirements.txt && /tmp/sitebuild/bin/python site/build.py && /tmp/sitebuild/bin/python site/check_dist.py",
  "outputDirectory": "site/dist",
  "installCommand": "echo 'no package manager: the site is built by site/build.py'",
  "framework": null,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/online-vs-offline.html",
      "destination": "/databricks-mlflow.html#part-5--online-vs-offline",
      "permanent": true
    },
    {
      "source": "/stratified-reporting-explained.html",
      "destination": "/05-statistics-and-stratified-reporting.html",
      "permanent": true
    },
    {
      "source": "/fde-playbook-audit.html",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/fde-playbook-end-to-end-evaluation.html",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
