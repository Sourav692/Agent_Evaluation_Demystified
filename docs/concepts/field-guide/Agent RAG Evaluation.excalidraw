    {"id":"m2_list1","type":"text","x":48,"y":1005,"width":180,"height":80,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":120018,"version":1,"versionNonce":120018,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Free, instant\n2. recall@K, MRR\n3. Schema checks\n4. End-state query","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Free, instant\n2. recall@K, MRR\n3. Schema checks\n4. End-state query","autoResize":true,"lineHeight":1.25},
    {"id":"m2_list2","type":"text","x":288,"y":1005,"width":180,"height":80,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":120019,"version":1,"versionNonce":120019,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. One small call\n2. Faithfulness\n3. Answer relevancy\n4. Contextual recall","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. One small call\n2. Faithfulness\n3. Answer relevancy\n4. Contextual recall","autoResize":true,"lineHeight":1.25},
    {"id":"m2_list3","type":"text","x":528,"y":1005,"width":180,"height":80,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":120020,"version":1,"versionNonce":120020,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Your own standard\n2. GEval rubric\n3. Answer correctness\n4. Task completion","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Your own standard\n2. GEval rubric\n3. Answer correctness\n4. Task completion","autoResize":true,"lineHeight":1.25},
    {"id":"m2_list4","type":"text","x":768,"y":1005,"width":180,"height":80,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":120021,"version":1,"versionNonce":120021,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. One BIG call\n2. Reads the whole run\n3. Judges the sequence\n4. Costliest jump","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. One BIG call\n2. Reads the whole run\n3. Judges the sequence\n4. Costliest jump","autoResize":true,"lineHeight":1.25},

    {"id":"m3_rect","type":"rectangle","x":0,"y":1160,"width":900,"height":270,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":130001,"version":1,"versionNonce":130001,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"m3_title","type":"text","x":40,"y":1180,"width":815,"height":35,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":130002,"version":1,"versionNonce":130002,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Module 3 — RAG Retrieval: Did the Right Evidence Arrive?","fontSize":28,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Module 3 — RAG Retrieval: Did the Right Evidence Arrive?","autoResize":true,"lineHeight":1.25},
    {"id":"m3_list","type":"text","x":40,"y":1235,"width":720,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":130003,"version":1,"versionNonce":130003,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Ingestion — Source vs index counts, checksums, parse and embedding checks\n2. Precision@K — Of the top K chunks, how many are relevant?\n3. Recall@K — Of all relevant chunks, how many made the top K?\n4. MRR — How high does the first relevant chunk rank?\n5. nDCG — Graded relevance; rewards putting the best chunk first\n6. No Labels? — Judged contextual precision, recall and relevancy\n7. Retrieved ≠ Seen — Test position, truncation and compression in the final prompt\n8. “It hallucinated” — Check recall@K first: the right chunk may never have arrived","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Ingestion — Source vs index counts, checksums, parse and embedding checks\n2. Precision@K — Of the top K chunks, how many are relevant?\n3. Recall@K — Of all relevant chunks, how many made the top K?\n4. MRR — How high does the first relevant chunk rank?\n5. nDCG — Graded relevance; rewards putting the best chunk first\n6. No Labels? — Judged contextual precision, recall and relevancy\n7. Retrieved ≠ Seen — Test position, truncation and compression in the final prompt\n8. “It hallucinated” — Check recall@K first: the right chunk may never have arrived","autoResize":true,"lineHeight":1.25},

    {"id":"m4_rect","type":"rectangle","x":0,"y":1470,"width":900,"height":290,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":140001,"version":1,"versionNonce":140001,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"m4_title","type":"text","x":40,"y":1490,"width":815,"height":35,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140002,"version":1,"versionNonce":140002,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Module 4 — RAG Generation: Did the Answer Stay Grounded?","fontSize":28,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Module 4 — RAG Generation: Did the Answer Stay Grounded?","autoResize":true,"lineHeight":1.25},
    {"id":"m4_list","type":"text","x":40,"y":1545,"width":760,"height":180,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140003,"version":1,"versionNonce":140003,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Claim Decomposition — Split the answer into atomic claims, score each one\n2. Answer Relevancy — Does it address what was asked? Needs the question only\n3. Faithfulness — Is every claim backed by the retrieved context? Higher = better\n4. Hallucination — Checked against a separate trusted corpus. Higher = WORSE\n5. Four Hallucinations — Unsupported, Contradicted, Stale, Inaccessible (a security defect)\n6. Citation Accuracy — Does each cited chunk actually back its claim?\n7. Answer Correctness — Needs expected_output; semantic similarity is only a proxy\n8. Rubric — Explicit numbered steps, not “check the answer is accurate”\n9. Trap — A wrong chunk, faithfully repeated, still passes faithfulness","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Claim Decomposition — Split the answer into atomic claims, score each one\n2. Answer Relevancy — Does it address what was asked? Needs the question only\n3. Faithfulness — Is every claim backed by the retrieved context? Higher = better\n4. Hallucination — Checked against a separate trusted corpus. Higher = WORSE\n5. Four Hallucinations — Unsupported, Contradicted, Stale, Inaccessible (a security defect)\n6. Citation Accuracy — Does each cited chunk actually back its claim?\n7. Answer Correctness — Needs expected_output; semantic similarity is only a proxy\n8. Rubric — Explicit numbered steps, not “check the answer is accurate”\n9. Trap — A wrong chunk, faithfully repeated, still passes faithfulness","autoResize":true,"lineHeight":1.25},

    {"id":"m5_rect","type":"rectangle","x":0,"y":1800,"width":900,"height":230,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":150001,"version":1,"versionNonce":150001,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"m5_title","type":"text","x":40,"y":1820,"width":786,"height":35,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":150002,"version":1,"versionNonce":150002,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Module 5 — Running RAG Evals: One Example to a Verdict","fontSize":28,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Module 5 — Running RAG Evals: One Example to a Verdict","autoResize":true,"lineHeight":1.25},
    {"id":"m5_list","type":"text","x":40,"y":1875,"width":640,"height":120,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":150003,"version":1,"versionNonce":150003,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. In-Pipeline — Score relevance and grounding live, and branch on the score\n2. Batch — Run the same checks over many queries to judge the system\n3. Golden Dataset — Curated cases with expected outputs, versioned\n4. Second Library — A second framework as a second opinion\n5. Slice Before You Conclude — Aggregates hide the failing segment\n6. Version Comparison — Same dataset, one deliberate change","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. In-Pipeline — Score relevance and grounding live, and branch on the score\n2. Batch — Run the same checks over many queries to judge the system\n3. Golden Dataset — Curated cases with expected outputs, versioned\n4. Second Library — A second framework as a second opinion\n5. Slice Before You Conclude — Aggregates hide the failing segment\n6. Version Comparison — Same dataset, one deliberate change","autoResize":true,"lineHeight":1.25},

    {"id":"m6_rect","type":"rectangle","x":0,"y":2070,"width":900,"height":290,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":160001,"version":1,"versionNonce":160001,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"m6_title","type":"text","x":40,"y":2090,"width":713,"height":35,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":160002,"version":1,"versionNonce":160002,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Module 6 — Conversations, Tools & Task Completion","fontSize":28,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Module 6 — Conversations, Tools & Task Completion","autoResize":true,"lineHeight":1.25},
    {"id":"m6_list","type":"text","x":40,"y":2145,"width":760,"height":180,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":160003,"version":1,"versionNonce":160003,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Per-Turn Relevance and Retention — Does each turn hold up and remember?\n2. Turn Pass Rates Multiply — Report the session number beside the turn number\n3. Simulated Users — Generate multi-turn cases instead of hand-writing them\n4. Tool Selection — Called tools vs expected_tools; decide how strict the match is\n5. Argument Correctness — Schema check first (free), then a judge on intent\n6. Silent Tool Failure — Read the tool span, not just the final string\n7. Score Doing Nothing — A missing call is an outcome too\n8. Task Completion — Judged rubric, or verify the end state\n9. Combine With the Minimum — Not the mean; one failed sub-score fails the case","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Per-Turn Relevance and Retention — Does each turn hold up and remember?\n2. Turn Pass Rates Multiply — Report the session number beside the turn number\n3. Simulated Users — Generate multi-turn cases instead of hand-writing them\n4. Tool Selection — Called tools vs expected_tools; decide how strict the match is\n5. Argument Correctness — Schema check first (free), then a judge on intent\n6. Silent Tool Failure — Read the tool span, not just the final string\n7. Score Doing Nothing — A missing call is an outcome too\n8. Task Completion — Judged rubric, or verify the end state\n9. Combine With the Minimum — Not the mean; one failed sub-score fails the case","autoResize":true,"lineHeight":1.25},

