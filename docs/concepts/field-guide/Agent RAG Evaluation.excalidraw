    {"id":"m8_labL","type":"text","x":60,"y":2772,"width":250,"height":22,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":180004,"version":1,"versionNonce":180004,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Outcome checks — did it work?","fontSize":17,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Outcome checks — did it work?","autoResize":true,"lineHeight":1.25},
    {"id":"m8_listL","type":"text","x":60,"y":2804,"width":420,"height":100,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":180005,"version":1,"versionNonce":180005,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Tool Selection Accuracy — coverage only\n2. Argument Correctness — valid inputs\n5. Task Success Rate — the ground-truth outcome\n6. Trajectory Match — fuzzy, set-based\n7. End-State Verification — read the record","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Tool Selection Accuracy — coverage only\n2. Argument Correctness — valid inputs\n5. Task Success Rate — the ground-truth outcome\n6. Trajectory Match — fuzzy, set-based\n7. End-State Verification — read the record","autoResize":true,"lineHeight":1.25},
