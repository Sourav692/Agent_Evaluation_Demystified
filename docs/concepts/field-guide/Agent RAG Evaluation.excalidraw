    {"id":"m8_labR","type":"text","x":560,"y":2772,"width":425,"height":22,"angle":0,"strokeColor":"#f08c00","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":180007,"version":1,"versionNonce":180007,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Step checks — at what price? would it work again?","fontSize":17,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Step checks — at what price? would it work again?","autoResize":true,"lineHeight":1.25},
    {"id":"m8_listR","type":"text","x":560,"y":2804,"width":420,"height":80,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":180008,"version":1,"versionNonce":180008,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"3. Redundant Calls — repeats a call that worked\n4. Step-wise Accuracy — share of steps that helped\n8. Recovery Rate — None if no errors, never 1.0\n9. Cost / Efficiency Proxy — wasted steps","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3. Redundant Calls — repeats a call that worked\n4. Step-wise Accuracy — share of steps that helped\n8. Recovery Rate — None if no errors, never 1.0\n9. Cost / Efficiency Proxy — wasted steps","autoResize":true,"lineHeight":1.25},
    {"id":"m8_note","type":"text","x":40,"y":2945,"width":640,"height":20,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":180009,"version":1,"versionNonce":180009,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Fail unexpected tools as well as missing ones. “Not measured” is not “failed”.","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Fail unexpected tools as well as missing ones. “Not measured” is not “failed”.","autoResize":true,"lineHeight":1.25},

    {"id":"m9_rect","type":"rectangle","x":0,"y":3030,"width":900,"height":270,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":190001,"version":1,"versionNonce":190001,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"m9_title","type":"text","x":40,"y":3050,"width":670,"height":35,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":190002,"version":1,"versionNonce":190002,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Module 9 — LLM as Judge: A Tool, Not an Oracle","fontSize":28,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Module 9 — LLM as Judge: A Tool, Not an Oracle","autoResize":true,"lineHeight":1.25},
    {"id":"m9_list","type":"text","x":40,"y":3105,"width":700,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":190003,"version":1,"versionNonce":190003,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Judge Capability — Use a judge at least as capable as the task\n2. Non-Determinism — One score is a noisy estimate; never gate on one row\n3. Rubric Sensitivity — A vague criterion makes the judge disagree with itself\n4. Cost Compounds — 5 dimensions × 500 cases = 2,500+ calls\n5. Validate the Validator — An unchecked judge detects change, not quality\n6. Agreement, Not Average — Measure how often it agrees with humans\n7. Fluent-but-Wrong — “Refund issued” sounds right; verify the end state\n8. Score Direction — Hallucination 0.9 means LOTS of hallucination","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Judge Capability — Use a judge at least as capable as the task\n2. Non-Determinism — One score is a noisy estimate; never gate on one row\n3. Rubric Sensitivity — A vague criterion makes the judge disagree with itself\n4. Cost Compounds — 5 dimensions × 500 cases = 2,500+ calls\n5. Validate the Validator — An unchecked judge detects change, not quality\n6. Agreement, Not Average — Measure how often it agrees with humans\n7. Fluent-but-Wrong — “Refund issued” sounds right; verify the end state\n8. Score Direction — Hallucination 0.9 means LOTS of hallucination","autoResize":true,"lineHeight":1.25},

    {"id":"m10_rect","type":"rectangle","x":0,"y":3340,"width":900,"height":270,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":200001,"version":1,"versionNonce":200001,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"m10_title","type":"text","x":40,"y":3360,"width":640,"height":35,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":200002,"version":1,"versionNonce":200002,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Module 10 — Production & Multi-Agent Systems","fontSize":28,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Module 10 — Production & Multi-Agent Systems","autoResize":true,"lineHeight":1.25},
    {"id":"m10_list","type":"text","x":40,"y":3415,"width":780,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":200003,"version":1,"versionNonce":200003,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"1. Offline vs Online — Answer-key checks stay offline; the rest can run on live traffic\n2. Traces and Spans — Every step and tool call becomes a queryable table\n3. Sampling — Sample judged checks; run deterministic ones on every trace\n4. Alerting — Never tighter than sample resolution (5% of 2,000 at 95% ≈ ±4.5 pts)\n5. First Alerts — Trace volume, error-span rate, scorer coverage\n6. Skill Evaluation — Judge a tool’s own output: is the generated SQL correct?\n7. Handoffs — Score routing apart from the parts; nested traces attribute the failure\n8. Measurements Expire Silently — A one-tool check misleads once a second tool arrives","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1. Offline vs Online — Answer-key checks stay offline; the rest can run on live traffic\n2. Traces and Spans — Every step and tool call becomes a queryable table\n3. Sampling — Sample judged checks; run deterministic ones on every trace\n4. Alerting — Never tighter than sample resolution (5% of 2,000 at 95% ≈ ±4.5 pts)\n5. First Alerts — Trace volume, error-span rate, scorer coverage\n6. Skill Evaluation — Judge a tool’s own output: is the generated SQL correct?\n7. Handoffs — Score routing apart from the parts; nested traces attribute the failure\n8. Measurements Expire Silently — A one-tool check misleads once a second tool arrives","autoResize":true,"lineHeight":1.25},

