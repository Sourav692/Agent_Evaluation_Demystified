    {"id":"m7_note","type":"text","x":40,"y":2590,"width":520,"height":20,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":170013,"version":1,"versionNonce":170013,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Score all three. Each layer can pass while the next one fails.","fontSize":16,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Score all three. Each layer can pass while the next one fails.","autoResize":true,"lineHeight":1.25},

