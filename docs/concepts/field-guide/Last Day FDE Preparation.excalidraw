      "link": null,
      "locked": false,
      "text": "Module 16 — Security & Enterprise Multi-Tenancy",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Module 16 — Security & Enterprise Multi-Tenancy",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bbEgNKfPL3ApXidUdLBej",
      "type": "text",
      "x": 757.452473958333,
      "y": 4020.6103515625,
      "width": 604.303466796875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 1068372717,
      "version": 1666,
      "versionNonce": 82290787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790539100911,
      "created": 1790534528528,
      "link": null,
      "locked": false,
      "text": "1. Authentication - User Identity\n2. Authorization and RBAC - Decice Permitted Operations\n3. ACL in Source System\n4. Isolation of Tenants\n5. Permission Aware RAG\n6. Least-Privilege Tools — Limit Enterprise Reach\n7. Secrets — Keep Credentials in Trusted Execution\n8. Make sure Sensitive Data (PII) is not exposed in tracing and output also.\n9. Data Residency\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Authentication - User Identity\n2. Authorization and RBAC - Decice Permitted Operations\n3. ACL in Source System\n4. Isolation of Tenants\n5. Permission Aware RAG\n6. Least-Privilege Tools — Limit Enterprise Reach\n7. Secrets — Keep Credentials in Trusted Execution\n8. Make sure Sensitive Data (PII) is not exposed in tracing and output also.\n9. Data Residency\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
