    {
      "id": "TqI79rSPB2hpa8gTmUaor",
      "type": "text",
      "x": 727.839192708333,
      "y": 3014.8377685546875,
      "width": 530.1755981445312,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 985259309,
      "version": 799,
      "versionNonce": 745499341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790539072801,
      "created": 1790535797783,
      "link": null,
      "locked": false,
      "text": "1. Timeout - Bound Queue\n2. Retry Classification — Separate Transient and Permanent Errors\n3. Retry with Backoff and Jitter\n4. Circuit Breaker\n5. Graceful degradation\n6. Indempotency\n7. Checkpoints\n8. Dead Letter Queue(DLQ)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Timeout - Bound Queue\n2. Retry Classification — Separate Transient and Permanent Errors\n3. Retry with Backoff and Jitter\n4. Circuit Breaker\n5. Graceful degradation\n6. Indempotency\n7. Checkpoints\n8. Dead Letter Queue(DLQ)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
