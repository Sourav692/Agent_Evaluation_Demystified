# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env
#
# Only OPENAI_API_KEY is needed to run most of the material. The rest are
# per-track: see the "Requires" line in each course/ or labs/ README.

# ---------------------------------------------------------------------------
# Required almost everywhere — LLM-as-judge, DeepEval, RAGAS, and every
# notebook that calls a generator or embedding model.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# courses/02-databricks-mlflow-evals/  — MLflow 3 GenAI evaluation on Databricks
# TELCOASSIST_PROVIDER selects the agent's backing model: "openai" | "databricks"
# ---------------------------------------------------------------------------
DATABRICKS_HOST=
DATABRICKS_TOKEN=
TELCOASSIST_PROVIDER=openai

# ---------------------------------------------------------------------------
# labs/agent-evaluation/arize-phoenix-labs/  — tracing + experiments
# Point at a self-hosted Phoenix instance, e.g. http://localhost:6006
# ---------------------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=

# ---------------------------------------------------------------------------
# labs/agent-evaluation/crewai-travel-planner/  — the search tool
# ---------------------------------------------------------------------------
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Optional alternative providers (shared/llm_providers.py)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
EXPERIENTIALLABS_API_KEY=
